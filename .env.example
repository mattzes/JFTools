# Von docker-compose gelesen. Kopieren nach `.env` und Werte anpassen:
#   cp .env.example .env

# Admin-Passwort (voller Zugriff):
APP_PASSWORD=bitte-aendern

# Kleiderkammer-Passwort (nur Kleiderkammer-Bereich, Personen nur lesend).
# Leer lassen/weglassen, wenn kein eingeschränkter Zugang gewünscht ist:
KLEIDERKAMMER_PASSWORD=bitte-aendern

# Zufälliger Schlüssel zum Signieren der Session-Cookie (min. 16 Zeichen).
# Erzeugen mit:  openssl rand -base64 32
AUTH_SECRET=bitte-langen-zufaelligen-wert-eintragen
